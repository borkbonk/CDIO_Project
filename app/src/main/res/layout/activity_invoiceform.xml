<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <EditText
        android:id="@+id/invoiceNameEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Invoice Name" />

    <EditText
        android:id="@+id/customerNameEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Customer Name" />

    <EditText
        android:id="@+id/invoiceDateEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Invoice Date" />

    <LinearLayout
        android:id="@+id/itemsContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">
    </LinearLayout>

    <Button
        android:id="@+id/addItemButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add Item" />

    <Button
        android:id="@+id/generateOrderButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Generate Order" />
</LinearLayout>
